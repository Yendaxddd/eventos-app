# ============ DISCORD BOT CONFIGURATION ============
DISCORD_TOKEN=your_bot_token_here
BOT_PREFIX=*
WEBHOOK_URL=your_webhook_url_here
QTE_CHANNEL_ID=channel_id_where_bot_runs
QTE_PLAYER_ROLE_ID=role_id_for_qte_players
GM_ROLE_ID=role_id_for_game_masters
ADMIN_USER_ID=your_user_id_for_admin_commands

# ============ API & AI CONFIGURATION ============
AI_ENABLED=true
# Ollama endpoint - use localhost for local, or external URL for Railway/cloud
OLLAMA_ENDPOINT=http://localhost:11434/api/generate
OLLAMA_MODEL=elbot
AI_TIMEOUT=30

